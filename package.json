{
  "name": "kit",
  "private": true,
  "workspaces": [
    "packages/reactive-vue"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:watch": "NODE_NO_WARNINGS=1 vitest",
    "docs:dev": "php artisan docs:commands && vitepress dev docs",
    "docs:build": "php artisan docs:commands && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.4",
    "@kit/reactive-vue": "workspace:*",
    "@tanstack/vue-query": "^5.102.8",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "laravel-echo": "^2.4.0",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.0",
    "vue-sonner": "^2.0.9",
    "workbox-window": "^7.4.1"
