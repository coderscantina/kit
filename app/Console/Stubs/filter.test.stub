    #[Test]
    public function a_sort_column_outside_the_allow_list_is_ignored(): void
    {
        $filter = new {{ feature }}Filter(['sort' => '-password']);

        {{ feature }}::query()->filter($filter)->get();

        $this->assertSame([], $filter->getSortColumns());
    }

    #[Test]
    public function the_inherited_pagination_helpers_are_not_reachable(): void
