<script setup lang="ts">
{{ page_imports }}
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '~/components/ui/table'
import TableEmptyRow from '~/components/ui/TableEmptyRow.vue'
import TableLoadingRow from '~/components/ui/TableLoadingRow.vue'
import { useReactiveQuery } from '~/lib/reactive'
import { useI18n } from '~/plugins/i18n'

const { t } = useI18n()
{{ format }}

/**
 * `list: true` keeps the previous rows on screen while the next args load.
 * The name is a literal off `Kit.ReactiveMap`, so `rows.data` is typed from
 * the query's result. Never fetch `/rq/*` directly.
 */
const rows = useReactiveQuery('{{ resource }}.list', undefined, { list: true })

const items = computed(() => rows.data.value ?? [])
</script>

<template>
  <div class="grid gap-5">
    <h1 class="text-2xl font-semibold text-primary">{{ t('{{ resource }}.title') }}</h1>

    <Table :label="t('{{ resource }}.title')">
      <TableHeader>
        <TableRow>
{{ headers }}
        </TableRow>
      </TableHeader>
      <TableBody
        :class="['transition-opacity', rows.isFetching.value && items.length ? 'opacity-50' : '']"
      >
        <TableLoadingRow
          v-if="rows.isPending.value"
          :colspan="{{ colspan }}"
          :rows="3"
        />
        <TableEmptyRow
          v-else-if="items.length === 0"
          :colspan="{{ colspan }}"
          :label="t('{{ resource }}.empty')"
        />
        <TableRow
          v-for="item in items"
          :key="item.id"
        >
{{ cells }}
        </TableRow>
      </TableBody>
    </Table>
  </div>
</template>
