<?php

declare(strict_types=1);

namespace App\Features\{{ feature }}\Queries;

use App\Features\{{ feature }}\Data\{{ data }};
use App\Features\{{ feature }}\Models\{{ feature }};
use Illuminate\Contracts\Auth\Authenticatable;
use Kit\Reactive\Attributes\ReactiveQuery;
use Kit\Reactive\NoArgs;
use Kit\Reactive\Query;
use Spatie\LaravelData\Data;

/**
 * @extends Query<NoArgs>
 */
#[ReactiveQuery('{{ name }}', result: {{ data }}::class, list: true)]
final class {{ class }} extends Query
{
    /**
     * This query takes no arguments yet. To give it some, write a Data class
     * (`php artisan make:data {{ feature }}/{{ args }}`), return it here and
     * change the @extends above to `Query<{{ args }}>`. PHPStan checks the
     * two agree, and $args is typed from there on.
     */
    public static function args(): string
    {
        return NoArgs::class;
    }

    public function authorize(Authenticatable $user, Data $args): void
    {
        $this->gate($user)->authorize('viewAny', {{ feature }}::class);
    }

    /**
     * Args only, never the current user: every subscriber asking this question
     * with these args shares one result, and handle() also runs on a worker
     * with no session. Scope through $args, check the caller in authorize().
     * A PHPStan rule enforces it.
     *
     * Declare a predicate once `{{ table }}` passes ~10k rows or takes writes
     * this query does not care about, so a recompute is not queued for every
     * row in the table:
     *
     *     public function reads(Data $args): array
     *     {
     *         return [Dep::eq('{{ table }}', 'owner_id', $args->ownerId)];
     *     }
     */
    public function handle(Data $args): mixed
    {
        return {{ data }}::collect({{ feature }}::query()->orderBy('id')->limit(50)->get());
    }
}
