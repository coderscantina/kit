<?php

declare(strict_types=1);

namespace App\Features\{{ feature }}\Policies;

use App\Policies\ResourcePolicy;

/**
 * `{{ resource }}.view` for viewAny/view, `{{ resource }}.manage` for create/update/delete.
 *
 * Stop extending ResourcePolicy the moment a rule depends on the model
 * (ownership, state): write every method out instead, because an inherited
 * create() or update() would turn a denial into an allow.
 */
class {{ feature }}Policy extends ResourcePolicy
{
    protected string $resource = '{{ resource }}';
}
