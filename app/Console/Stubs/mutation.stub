<?php

declare(strict_types=1);

namespace App\Mutations\{{ feature }};

use App\Data\{{ args }};
use App\Data\{{ data }};
use App\Models\{{ feature }};
use Illuminate\Contracts\Auth\Authenticatable;
use Kit\Reactive\Attributes\ReactiveMutation;
use Kit\Reactive\Mutation;
use Spatie\LaravelData\Data;

/**
 * @extends Mutation<{{ args }}>
 */
#[ReactiveMutation('{{ name }}', result: {{ data }}::class)]
final class {{ class }} extends Mutation
{
    public static function args(): string
    {
        return {{ args }}::class;
    }

    public function authorize(Authenticatable $user, Data $args): void
    {
        $this->gate($user)->authorize('create', {{ feature }}::class);
    }

    /**
     * Runs inside the transaction the runner opened. Do not call
     * DB::transaction, afterCommit or dispatch an invalidation here; a
     * PHPStan rule fails the build if you do. Use $this->lock($model) to
     * read a row you are about to branch on.
     */
    public function handle(Data $args): {{ data }}
    {
        return {{ data }}::from({{ feature }}::query()->create(['name' => $args->name]));
    }
}
