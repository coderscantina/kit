{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "vue", "oxc", "import"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-unsafe-optional-chaining": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/await-thenable": "warn",
    "typescript/no-unsafe-declaration-merging": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/no-useless-spread": "warn",
    "import/no-cycle": "warn",
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "REST goes through an api resource in resources/js/api/resources, reactive data through useReactiveQuery/useReactiveMutation from ~/lib/reactive, AI through useAiStream. CLAUDE.md section 4."
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/node_modules",
    "public/build",
    "docs/.vitepress/cache",
    "docs/.vitepress/dist",
    "resources/js/types/*.d.ts",
    "vendor",
    "storage"
  ],
  "overrides": [
    {
      "files": [
        "resources/js/api/client.ts",
        "resources/js/composables/useAiStream.ts",
        "resources/js/plugins/echo.ts",
        "packages/reactive-vue/src/**",
        "tests/**"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
