{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kit/app",
    "type": "project",
    "description": "Laravel + Vue starter kit with a reactive data layer.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "kit/reactive": "@dev",
        "laravel/horizon": "^5.48",
        "laravel/octane": "^2.19",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3",
        "predis/predis": "^3.6",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6|^9.0",
        "phpunit/phpunit": "^13.3",
        "larastan/larastan": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Kit\\Reactive\\Tests\\": "packages/reactive/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/reactive",
            "options": {
                "symlink": true
            }
        }
    ]
}
