# Every variable the app reads. `php artisan config:validate` refuses to boot
# production when a required one is missing; see config/kit.php.

APP_NAME=Kit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Baked into the image by the Dockerfile; leave unset locally.
# APP_VERSION=dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# null derives the flag (see config/features.php); true/false overrides.
APP_FEATURE_REALTIME=
APP_ALLOW_REGISTRATION=
APP_FEATURE_IMPERSONATION=true

# Comma-separated proxy IPs or "*" behind a trusted load balancer.
TRUSTED_PROXIES=

PASSWORD_CONFIRMATION_MINUTES=15
TOTP_GRACE_MINUTES=30
INVITE_EXPIRY_DAYS=7

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kit
DB_USERNAME=kit
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# reverb enables realtime; null disables it and the SPA skips Echo.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Registry, mutation counter and debounce keys (see config/reactive.php).
REACTIVE_REDIS_CONNECTION=default
REACTIVE_REGISTRY=redis

REVERB_APP_ID=kit
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8001

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
# Octane worker processes inside the container.
OCTANE_WORKERS=4

HORIZON_DOMAIN=
HORIZON_PATH=horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Social login: a provider is offered only when both values are set.
SOCIAL_GITHUB_CLIENT_ID=
SOCIAL_GITHUB_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

# Product analytics key handed to the SPA; empty disables it.
ANALYTICS_KEY=
ANALYTICS_HOST=

# MySQL + Redis for the reactive test suite (phpunit --testsuite=reactive).
# Unset means the suite is skipped.
REACTIVE_TEST_DB=
REACTIVE_TEST_DB_HOST=127.0.0.1
REACTIVE_TEST_DB_PORT=3306
REACTIVE_TEST_DB_USERNAME=root
REACTIVE_TEST_DB_PASSWORD=
REACTIVE_TEST_REDIS_HOST=127.0.0.1
REACTIVE_TEST_REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# ── Docker Compose (bin/dev) ────────────────────────────────────────────────
# Loopback by default; the stack speaks plain HTTP. 0.0.0.0 exposes it.
APP_BIND=127.0.0.1
APP_PORT=8000
# Required: compose refuses to boot with a default database password.
# bin/dev writes a random one into .env on first run.
DB_ROOT_PASSWORD=
# false on every container but one, so two never migrate the same database.
KIT_AUTO_SETUP=true

# ── Delivery (deploy/receiver.sh, deploy/compose.prod.yml) ──────────────────
# The GHCR repository and the tag to run; the release workflow pushes both
# `production` and the immutable version tag.
KIT_IMAGE=
KIT_IMAGE_TAG=production
# Shared with the GitHub workflow; the receiver verifies X-Kit-Signature
# against it before it touches docker.
DEPLOY_WEBHOOK_SECRET=
